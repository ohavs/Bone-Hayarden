rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects: public read and write (admin panel manages authorization)
    match /projects/{document=**} {
      allow read, write: if true;
    }
    
    // Leads: public read and write (form submissions + admin viewing)
    match /leads/{document=**} {
      allow read, write: if true;
    }
    
    // Settings: public read and write (admin password check + updates)
    match /settings/{document=**} {
      allow read, write: if true;
    }
    
    // Reviews: public read and write
    match /reviews/{document=**} {
      allow read, write: if true;
    }
  }
}
